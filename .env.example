# ==============================================================================
# AlumniPath — Supabase Environment Configuration
# ==============================================================================
# Copy this file to .env.local and populate with your project credentials:
#   cp .env.example .env.local
#
# Where to find these in Supabase:
# 1. Open your project dashboard at https://app.supabase.com
# 2. Navigate to Project Settings -> API (or API Settings)
# 3. Copy "Project URL" into NEXT_PUBLIC_SUPABASE_URL
# 4. Copy "anon public" Project API key into NEXT_PUBLIC_SUPABASE_ANON_KEY
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Anon / Public Key (Safe to expose in browser code; RLS protects tables)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
